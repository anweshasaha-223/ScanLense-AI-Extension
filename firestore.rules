rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'lastLogin']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'lastLogin']) &&
        data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid &&
        data.email is string && data.email.size() <= 256 &&
        data.displayName is string && data.displayName.size() <= 120 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
        data.lastLogin is string && data.lastLogin.size() <= 64;
    }

    function isValidAnalysis(data, userId) {
      return data.keys().hasAll(['userId', 'risk', 'scamTypeName', 'summary', 'threatScore', 'evidenceCount', 'linkCount', 'userAction', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'risk', 'scamTypeName', 'summary', 'threatScore', 'evidenceCount', 'linkCount', 'userAction', 'createdAt']) &&
        data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid && data.userId == userId &&
        data.risk is string && data.risk.size() <= 32 &&
        data.scamTypeName is string && data.scamTypeName.size() <= 200 &&
        data.summary is string && data.summary.size() <= 2000 &&
        data.threatScore is number &&
        data.evidenceCount is number &&
        data.linkCount is number &&
        data.userAction is string && data.userAction.size() <= 64 &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidChatMessage(data, userId) {
      return data.keys().hasAll(['userId', 'role', 'content', 'model', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'role', 'content', 'model', 'createdAt']) &&
        data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid && data.userId == userId &&
        data.role is string && data.role.size() <= 16 &&
        data.content is string && data.content.size() <= 4000 &&
        data.model is string && data.model.size() <= 64 &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Health check document for connection testing
    match /test/connection {
      allow get: if true;
    }

    // User document and private subcollections
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'photoURL', 'lastLogin']);

      match /analyses/{analysisId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(analysisId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(analysisId) && isValidAnalysis(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(analysisId);
      }

      match /chats/{chatId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(chatId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(chatId) && isValidChatMessage(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(chatId);
      }
    }
  }
}
